{
  "llm": {
    "baseUrl": "https://api.openai.com/v1",
    "model": "gpt-4o-mini",
    "apiKey": "在此填入你的密钥，或改用环境变量 ASTOCK_LLM_API_KEY",
    "apiKeyHeader": "Authorization",
    "timeoutMs": 90000,
    "maxRetries": 2,
    "retryBaseDelayMs": 1200,
    "temperature": 0.2,
    "maxTokens": 4000,
